# ── Supabase (required) ────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Site branding ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://app.taborsynergy.com
NEXT_PUBLIC_SITE_NAME=ChurchConnect
NEXT_PUBLIC_SITE_DESCRIPTION=Your church, beautifully connected.
NEXT_PUBLIC_OWNER_EMAIL=admin@taborsynergy.com
NEXT_PUBLIC_OWNER_NAME=Tabor Synergy

# ── Stripe (USD payments) ─────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Also set SITE_URL in Supabase Edge Function secrets for CORS

# ── Razorpay (INR payments) ───────────────────────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ── Email (Resend / SendGrid) ─────────────────────────────────────────────────
RESEND_API_KEY=re_...
# FROM address must be a verified domain: admin@taborsynergy.com

# ── Auth ──────────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=your-random-32-char-secret
NEXTAUTH_URL=https://app.taborsynergy.com

# ── Licensing cron ────────────────────────────────────────────────────────────
LICENSE_CRON_SECRET=your-random-cron-secret

# ── PayPal (SaaS subscription billing — pastors pay Tabor Synergy) ───────────
# Mode: sandbox (dev) or live (production)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id
# PayPal billing plan IDs — create these in the PayPal developer dashboard
# under Billing → Plans, then paste the Plan IDs here.
PAYPAL_PLAN_GROW_MONTHLY=P-XXXXXXXXXXXXXXXXXXXX
PAYPAL_PLAN_GROW_ANNUAL=P-XXXXXXXXXXXXXXXXXXXX
PAYPAL_PLAN_PARISH_MONTHLY=P-XXXXXXXXXXXXXXXXXXXX
PAYPAL_PLAN_PARISH_ANNUAL=P-XXXXXXXXXXXXXXXXXXXX
PAYPAL_PLAN_DIOCESE_MONTHLY=P-XXXXXXXXXXXXXXXXXXXX
PAYPAL_PLAN_DIOCESE_ANNUAL=P-XXXXXXXXXXXXXXXXXXXX
PAYPAL_PLAN_NETWORK_MONTHLY=P-XXXXXXXXXXXXXXXXXXXX
PAYPAL_PLAN_NETWORK_ANNUAL=P-XXXXXXXXXXXXXXXXXXXX
# Your PayPal.me link (shown on pricing page for manual payments)
NEXT_PUBLIC_PAYPAL_ME=https://paypal.me/write2dinakar

# ── Sentry error monitoring (optional — leave blank to disable) ───────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
